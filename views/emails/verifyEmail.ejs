<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify Your Cardel Account</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=MuseoModerno:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
</head>

<body style="margin:0;padding:0;background-color:#0b1220;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0b1220;padding:40px 0;">
<tr>
<td align="center">

<!-- Main Container -->
<table width="600" cellpadding="0" cellspacing="0" style="background-color:#111827;border-radius:10px;overflow:hidden;box-shadow:0 0 20px rgba(0,0,0,0.4);">

<!-- Header -->
<tr>
<td align="center" style="padding:30px 20px;border-bottom:1px solid #1f2937;">
<img src="https://<%= hostname %>/media/icons/logo.png" alt="Cardel Logo" width="80" style="display:block;margin-bottom:10px;">
<h1 style="color:#ffffff;margin:0;font-size:26px;" style="font-family: 'MuseoModerno', sans-serif; font-optical-sizing: auto; font-style: normal;">CARDEL</h1>
<p style="color:#9ca3af;margin-top:6px;font-size:14px;">Subscriptions & accounts simplified</p>
</td>
</tr>
<!-- Content -->
<tr>
<td style="padding:40px 30px;color:#e5e7eb;">

<h2 style="margin-top:0;color:#ffffff;">Welcome, <%= username %> 👋</h2>

<p style="line-height:1.6;font-size:15px;color:#cbd5e1;">
Thanks for creating your Cardel account. To start managing your subscriptions and notifications, please verify your email address.
</p>

<!-- Button -->
<table cellpadding="0" cellspacing="0" width="100%" style="margin:30px 0;">
<tr>
<td align="center">

<a href="<%= verifyUrl %>"
style="
background-color:#3b82f6;
color:#ffffff;
padding:14px 26px;
text-decoration:none;
border-radius:6px;
font-size:16px;
font-weight:bold;
display:inline-block;
">
Verify My Email
</a>

</td>
</tr>
</table>

<p style="font-size:14px;color:#9ca3af;line-height:1.6;">
This verification link will expire in <strong>1 hour</strong>.
</p>

<p style="font-size:14px;color:#9ca3af;line-height:1.6;">
If the button above doesn't work, copy and paste this link into your browser:
</p>

<p style="word-break:break-all;font-size:13px;color:#60a5fa;">
<%= verifyUrl %>
</p>

</td>
</tr>

<!-- Footer -->
<tr>
<td style="border-top:1px solid #1f2937;padding:25px;text-align:center;">

<p style="font-size:13px;color:#6b7280;margin:0;">
You received this email because you signed up for Cardel.
</p>

<p style="font-size:13px;color:#6b7280;margin:8px 0 0 0;">
If this wasn't you, you can safely ignore this email.
</p>

<p style="font-size:12px;color:#4b5563;margin-top:16px;">
© 2026 Cardel. All rights reserved.
</p>

</td>
</tr>

</table>

</td>
</tr>
</table>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/png" href="media/logo.png">
  <link rel="stylesheet" href="css/signup.css">
  <link rel="stylesheet" href="css/error.css">
  <link rel="stylesheet" href="css/otherBackground.css">
  <link rel="stylesheet" href="css/rippleBtn.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=MuseoModerno:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
  <title>Sign up · Cardel</title>

  <script src="js/signup.js" defer></script>
</head>

<body>

  <div class="hero-bg">
      <div class="background">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
      </div>
  </div>

  <div class="parallax-layer" data-depth="0.04">

    <div class="container">
      <div class="brand">
        <img src="media/logo.png" alt="Cardel icon">
        <span class="cardelHeading">CARDEL</span>
      </div>

      <div class="subtitle">
        Create your account and start tracking subscriptions for free.
      </div>

      <form id="signupForm">
        <div>
          <label>Username</label>
          <input type="text" name="username" placeholder="f3tch" required />
        </div>

        <div>
          <label>Email address</label>
          <input type="email" name="email" placeholder="support@cardel.app" required />
        </div>

        <div>
          <label>Password</label>
          <input type="password" name="password" placeholder="••••••••" required />
          <div class="hint">At least 8 characters</div>
        </div>

        <div>
          <label>Confirm password</label>
          <input type="password" name="confirm_password" placeholder="••••••••" required />
        </div>

        <div class="consent">
          <label class="checkbox">
            <input type="checkbox" name="privacy_consent" value="false">
            <span>
              I agree to your ToS and accept I will receive emails and messages about renewals along with ads for the free plan.
              <a href="/privacy#termsofservices" target="_blank">Learn more</a>
            </span>
          </label>
          <br>
          <label class="checkbox">
            <input type="checkbox" name="marketing_consent" value="false">
            <span>
              I agree to receive sponsored emails and messages"
              <a href="/privacy#sponsored"  target="_blank">Learn more</a>
            </span>
          </label>
        </div>

        <button type="submit" class="btn btn-secondary ripple-btn"><span>Sign up</span></button>
      </form>

      <div class="footer">
        Already have an account?
        <a href="login">Log in</a>
      </div>
    </div>
  </div>

  <!-- <script src="js/heroParallax.js"></script> -->
</body>
</html>
